# Copie para .env.local e preencha. `.env*` está no .gitignore.
#
# Os dois valores saem do painel do Supabase, em Project Settings › API.
# A chave anônima é pública por natureza — o Next a embute no bundle do
# navegador — e quem protege os dados é a RLS. A chave de service_role
# ignora RLS e nunca deve aparecer numa variável NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
